{
  "name": "inset",
  "version": "0.3.0",
  "private": true,
  "description": "View and control an Android emulator and inspect React Native components inside VS Code.",
  "main": "./dist/extension.js",
  "scripts": {
    "check": "npm run build && npm test && npm run test:channel && npm run test:webview && npm run test:inspector",
    "build": "npm run typecheck && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsc && node --test out/test/*.test.js",
    "test:webview": "tsc && node scripts/test-webview.mjs",
    "test:emulator": "tsc && node scripts/test-emulator.cjs",
    "test:extension": "tsc && node scripts/test-extension.cjs",
    "vscode:prepublish": "npm run build",
    "package": "node scripts/package.mjs",
    "test:channel": "tsc && node --test out/test/channel.integration.js",
    "test:inspector": "tsc && node scripts/test-inspector.mjs",
    "test:inspector:live": "tsc && node scripts/test-inspector.mjs --live",
    "test:keyboard": "tsc && node scripts/test-keyboard.cjs"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.12.0",
    "@grpc/proto-loader": "^0.7.13",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/vscode": "^1.144.0",
    "@types/ws": "^8.18.2",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2"
  },
  "displayName": "Inset",
  "publisher": "local",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onView:inset.emulator"
  ],
  "contributes": {
    "commands": [
      {
        "command": "inset.open",
        "title": "Inset: Open Emulator"
      },
      {
        "command": "inset.refresh",
        "title": "Inset: Refresh Connection"
      },
      {
        "command": "inset.diagnostics",
        "title": "Inset: Show Diagnostics"
      },
      {
        "command": "inset.benchmark",
        "title": "Inset: Measure Scrolling Performance"
      },
      {
        "command": "inset.openEditor",
        "title": "Inset: Open Emulator in Editor"
      },
      {
        "command": "inset.openSidebar",
        "title": "Inset: Move Emulator to Sidebar"
      },
      {
        "command": "inset.inspect",
        "title": "Inset: Open React Native Inspector"
      },
      {
        "command": "inset.pickComponent",
        "title": "Inset: Pick React Native Component"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "inset",
          "title": "Inset",
          "icon": "media/inset.svg"
        }
      ]
    },
    "views": {
      "inset": [
        {
          "type": "webview",
          "id": "inset.emulator",
          "name": "Emulator"
        }
      ]
    },
    "configuration": {
      "title": "Inset",
      "properties": {
        "inset.adbPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Absolute path to adb. Takes precedence over SDK Path."
        },
        "inset.sdkPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Android SDK directory containing platform-tools."
        },
        "inset.discoveryPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Override the directory containing emulator pid_*.ini discovery files."
        },
        "inset.lowBandwidth": {
          "type": "boolean",
          "default": false,
          "description": "Use PNG and cap resolution at one third of native size; encoding can reduce FPS."
        },
        "inset.showPerformance": {
          "type": "boolean",
          "default": false,
          "description": "Expand performance details by default. The compact FPS indicator remains visible."
        },
        "inset.streamMode": {
          "type": "string",
          "enum": [
            "smooth",
            "png"
          ],
          "enumDescriptions": [
            "Raw RGBA over a local binary channel, capped in resolution for a 60 FPS target.",
            "PNG compression to reduce bandwidth; encoding may reduce FPS."
          ],
          "default": "smooth",
          "description": "Emulator streaming mode."
        },
        "inset.metroUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8081",
          "description": "Local Metro development-server URL used by the React Native inspector."
        }
      }
    }
  },
  "overrides": {
    "@vscode/vsce": {
      "minimatch": "^11.0.1"
    }
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "The emulator is available; React Native runtime inspection requires workspace trust."
    }
  }
}
