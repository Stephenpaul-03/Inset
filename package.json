{
  "name": "portal-emulator",
  "version": "0.1.0",
  "private": true,
  "description": "View and control an already-running Android emulator in the VS Code sidebar.",
  "main": "./dist/extension.js",
  "scripts": {
    "build": "npm run typecheck && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsc && node --test out/test/*.test.js",
    "test:webview": "node scripts/test-webview.mjs",
    "test:emulator": "tsc && node scripts/test-emulator.cjs",
    "test:extension": "tsc && node scripts/test-extension.cjs",
    "vscode:prepublish": "npm run build",
    "package": "vsce package --no-dependencies --allow-missing-repository --out artifacts/portal-emulator-0.1.0.vsix"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.12.0",
    "@grpc/proto-loader": "^0.7.13"
  },
  "devDependencies": {
    "@types/vscode": "^1.95.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2"
  },
  "displayName": "Portal Emulator",
  "publisher": "local",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onView:portal.emulator"
  ],
  "contributes": {
    "commands": [
      {
        "command": "portal.open",
        "title": "Portal: Open Emulator"
      },
      {
        "command": "portal.refresh",
        "title": "Portal: Refresh Connection"
      },
      {
        "command": "portal.diagnostics",
        "title": "Portal: Show Diagnostics"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "portal",
          "title": "Portal",
          "icon": "media/portal.svg"
        }
      ]
    },
    "views": {
      "portal": [
        {
          "type": "webview",
          "id": "portal.emulator",
          "name": "Android Emulator"
        }
      ]
    },
    "configuration": {
      "title": "Portal",
      "properties": {
        "portal.adbPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Absolute path to adb. Takes precedence over SDK Path."
        },
        "portal.sdkPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Android SDK directory containing platform-tools."
        },
        "portal.discoveryPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Override the directory containing emulator pid_*.ini discovery files."
        },
        "portal.lowBandwidth": {
          "type": "boolean",
          "default": false,
          "description": "Limit PNG streaming to at most one third of native resolution."
        },
        "portal.showPerformance": {
          "type": "boolean",
          "default": true,
          "description": "Show drawn FPS, PNG decode time, and frame age."
        }
      }
    }
  },
  "overrides": {
    "@vscode/vsce": {
      "minimatch": "^11.0.1"
    }
  }
}
